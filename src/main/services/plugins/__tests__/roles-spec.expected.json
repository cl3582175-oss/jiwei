        "outputs": {
          "inbox": true
        }
      },
      {
        "id": "school-daily-recall",
        "name": "晚间三问",
        "trigger": {
          "type": "schedule",
          "every": "day",
          "time": "21:00"
        },
        "tools": ["note_find", "note_read"],
        "outputs": {
          "inbox": true
        }
      }
