      {
        "id": "school-choice",
        "title": "选科与志愿",
        "criteria": [
          {
            "name": "兴趣与长期动力",
            "weight": 4
          },
          {
            "name": "成绩优势与排名稳定性",
            "weight": 5
          },
          {
            "name": "对想读专业的覆盖",
            "weight": 4
          },
          {
            "name": "竞争强度",
            "weight": 3
          },
          {
            "name": "学习负担与时间",
            "weight": 3
          }
        ],
        "questions": [
          "最近三次考试各科排名大概在哪？",
          "有没有特别想读的专业或方向？",
          "哪一科你学起来最不痛苦？",
          "家里有没有必须考虑的限制（地域、费用）？"
        ]
