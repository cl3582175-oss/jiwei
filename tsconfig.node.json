{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"] }
  },
  "include": [
    "electron.vite.config.ts",
    "drizzle.config.ts",
    "drizzle.profile.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/worker/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/src/i18n/zh-CN.ts",
    "src/renderer/src/i18n/en.ts",
    "src/renderer/src/features/mistakes/messages.ts",
    "src/renderer/src/features/reading/messages.ts",
    "src/renderer/src/features/agent/spendMessages.ts",
    "src/renderer/src/features/settings/safetyMessages.ts",
    "src/renderer/src/features/today/messages.ts",
    "src/renderer/src/features/agent/messages.ts"
  ]
}
